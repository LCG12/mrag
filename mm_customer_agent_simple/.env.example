# Main OpenAI-compatible language model.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Optional DashScope compatibility settings.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

# Optional vector retrieval. Leave disabled to use the local BM25 index only.
ENABLE_VECTOR_RETRIEVAL=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# Optional remote reranking. Leave disabled to keep BM25 ranking.
ENABLE_RERANK=false
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank

# Image understanding. OCR is local; api_vlm requires its own compatible key.
MAX_IMAGE_INPUTS=10
OCR_LANGUAGES=ch_sim,en
OCR_MODEL_STORAGE_DIR=storage5/easyocr_models
IMAGE_ANALYSIS_TOOLS=ocr
API_VLM_API_KEY=
API_VLM_MODEL=qwen-vl-plus
API_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOCAL_VLM_ENABLED=false
LOCAL_VLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_VLM_MODEL=

# Local index and retrieval parameters.
STORAGE_DIR=storage5
QDRANT_COLLECTION=manual_chunks
VECTOR_TOP_K=50
BM25_TOP_K=50
RRF_K=60
RERANK_TOP_K=8
FINAL_CONTEXT_TOP_K=6

# Optional customer FAQ vector collections.
ENABLE_CUSTOMER_QA_RETRIEVAL=false
CUSTOMER_QA_PATH=FAQ.json
CUSTOMER_QA_QDRANT_PATH=storage5/customer_qa_qdrant
CUSTOMER_QA_QUERY_COLLECTION=customer_qa_query
CUSTOMER_QA_ANSWER_COLLECTION=customer_qa_answer
CUSTOMER_QA_VECTOR_TOP_K=3
CUSTOMER_QA_MIN_VECTOR_SCORE=0.35
CUSTOMER_QA_MIN_VECTOR_SCORE_GAP=1.1
