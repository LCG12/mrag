DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ImageModalProcessor needs a genuinely vision-capable model endpoint.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Local Qwen3 Embedding (recommended for this project).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=./qwen3-embedding-0.6b
EMBEDDING_DEVICE=auto
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=4
EMBEDDING_QUERY_PROMPT_NAME=query
EMBEDDING_MAX_TOKENS=8192

# OpenAI-compatible alternative. Set EMBEDDING_PROVIDER=openai to use it.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

MY_MRAG_DATA_DIR=./data
